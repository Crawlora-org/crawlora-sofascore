{
  "name": "crawlora/sofascore",
  "description": "Crawlora SofaScore API client with 109 endpoints for live events, match details, lineups, statistics, tournaments, and player/team data",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "sofascore",
    "sofascore-api",
    "sofascore-scraper",
    "sofascore-data",
    "sofascore-live-events",
    "sofascore-match-details",
    "sofascore-lineups",
    "sofascore-statistics",
    "sofascore-tournaments",
    "sofascore-player-team-data"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Sofascore\\": "src/Crawlora/Sofascore/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Sofascore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=sofascore-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-sofascore",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=sofascore-php-api-docs"
  }
}
